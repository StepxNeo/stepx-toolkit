{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "src/**/*.d.ts", "bin/**/*.js", "test/**/*.js", "scripts/**/*.mjs"]
}
